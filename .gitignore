# ==============================================================================
# NEXTRADE AI - Git Ignore Rules
# ==============================================================================

# --- Local Project Documentation (MUST remain local & untracked) ---
/documents/

# --- Environment & Secrets (Keep .env.example tracked) ---
.env
.env.*
!.env.example
*.env.local
secrets/
*.pem
*.key
*.crt
*.csr
*.cer
*.p12
*.pfx
*.jks
*.keystore

# --- Python Virtual Environments, Caches & Build Artifacts ---
.venv/
venv/
env/
ENV/
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
/lib/
/lib64/
/parts/
/sdist/
/var/
wheels/
share/python-wheels/
