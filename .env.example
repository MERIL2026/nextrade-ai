# ==============================================================================
# NEXTRADE AI — Environment Configuration Template (Phase 1 Foundation)
# ==============================================================================
# Usage:
#   1. Copy this file to `.env` (never commit `.env` to Git).
#   2. Replace every `REPLACE_WITH_*` placeholder before starting services.
#   3. Never store secrets in `NEXT_PUBLIC_*` variables or client bundles.
# ==============================================================================

# --- Application Runtime ---
APP_NAME=NEXTRADE AI
APP_ENV=local
DEBUG=false
LOG_LEVEL=INFO
API_PREFIX=/api/v1
# Generate a high-entropy random secret (>= 32 chars), e.g.:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET=REPLACE_WITH_MIN_32_CHAR_HIGH_ENTROPY_SECRET

# --- Host Development Port Bindings (127.0.0.1 loopback only) ---
# Defaults avoid common local port collisions on 5432, 6379, and 8000.
# Adjust if different ports are preferred on your workstation.
WEB_HOST_PORT=3000
API_HOST_PORT=8001
POSTGRES_HOST_PORT=5435
REDIS_HOST_PORT=6381

# --- CORS & Base URLs ---
# Strict allowlist (comma-separated origins or JSON array); never combine wildcard `*` with credentialed requests.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8001

# --- Next.js Frontend Configuration ---
NEXT_PUBLIC_APP_NAME=NEXTRADE AI
NEXT_PUBLIC_APP_ENV=local
NEXT_PUBLIC_API_BASE_URL=http://localhost:8001
# Internal service URL used only by Next.js server-side runtime inside Docker:
INTERNAL_API_BASE_URL=http://api:8000

# --- PostgreSQL (Authoritative System of Record) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=nextrade
# Schema owner / migration role (used by Alembic DDL operations)
POSTGRES_OWNER_USER=nextrade_owner
POSTGRES_OWNER_PASSWORD=REPLACE_WITH_LOCAL_OWNER_PASSWORD
# Least-privilege runtime application role (non-superuser, used by API and workers)
POSTGRES_APP_USER=nextrade_app
POSTGRES_APP_PASSWORD=REPLACE_WITH_LOCAL_APP_PASSWORD

# SQLAlchemy connection URLs (container network host is `postgres:5432`):
DATABASE_URL=postgresql+psycopg://nextrade_app:REPLACE_WITH_LOCAL_APP_PASSWORD@postgres:5432/nextrade
MIGRATION_DATABASE_URL=postgresql+psycopg://nextrade_owner:REPLACE_WITH_LOCAL_OWNER_PASSWORD@postgres:5432/nextrade

# --- Redis (Ephemeral Cache & Celery Broker Only) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=REPLACE_WITH_LOCAL_REDIS_PASSWORD
REDIS_URL=redis://:REPLACE_WITH_LOCAL_REDIS_PASSWORD@redis:6379/0
CELERY_BROKER_URL=redis://:REPLACE_WITH_LOCAL_REDIS_PASSWORD@redis:6379/1
CELERY_RESULT_BACKEND=redis://:REPLACE_WITH_LOCAL_REDIS_PASSWORD@redis:6379/2

# --- Future Phase Placeholders (Disabled / Unused in Phase 1) ---
MARKET_DATA_PROVIDER=none
MARKET_DATA_API_KEY=REPLACE_WITH_FUTURE_PROVIDER_KEY
AI_PROVIDER=none
OLLAMA_BASE_URL=http://localhost:11434

