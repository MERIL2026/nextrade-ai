# Enforce consistent line endings across Windows hosts and Linux Docker containers
* text=auto eol=lf

*.py text eol=lf
*.pyi text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.ini text eol=lf
*.md text eol=lf
*.css text eol=lf
*.sql text eol=lf
*.sh text eol=lf
Dockerfile* text eol=lf
.env.example text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
.python-version text eol=lf
.nvmrc text eol=lf

# Windows batch/PowerShell scripts can retain CRLF if added later
*.ps1 text eol=crlf
*.bat text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.pdf binary

